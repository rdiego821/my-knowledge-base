---
// src/components/Flashcard.astro
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details class="flashcard-container">
  <summary class="flashcard-question">
    <span class="icon">❓</span> <strong>{question}</strong>
  </summary>
  <div class="flashcard-answer">
    <slot />
  </div>
</details>

<style>
  .flashcard-container {
    background-color: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    margin: 1rem 0;
    padding: 0.85rem 1.1rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .flashcard-question {
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    user-select: none;
  }

  .flashcard-answer {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--sl-color-gray-4);
    color: var(--sl-color-gray-2);
    font-size: 0.95rem;
  }

  .flashcard-answer :global(code) {
    background-color: var(--sl-color-gray-5) !important;
    color: var(--sl-color-text-accent) !important;
    border: 1px solid var(--sl-color-gray-4);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }
</style>